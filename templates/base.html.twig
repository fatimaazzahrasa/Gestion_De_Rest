<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Resto-Booking !{% endblock %}</title>
        
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
        {# Theme Lux de Bootswatch #}
        <link rel="stylesheet" href="https://bootswatch.com/5/lux/bootstrap.min.css">
        {# FontAwesome pour les icones (pen, trash...) #}
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        
        {% block stylesheets %}{% endblock %}

        <style>
            /* Correction pour le thème Lux */
            .form-floating > .form-control::placeholder {
                color: transparent;
            }
            .navbar-brand {
                letter-spacing: 2px;
                font-weight: bold;
            }
        </style>
    </head>
    <body>
        <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
            <div class="container-fluid">
                <a class="navbar-brand text-uppercase" href="{{ path('app_home') }}">Resto-Booking</a>
                
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto text-uppercase small">
                        {# رابط الطوابل - مهم جدا باش تنقلي للمشروع ديالك #}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_table_index') }}">Les Tables</a>
                        </li>

                        {% if app.user %}
                            
                            {# ========================================================= #}
                            {# === LOGIQUE DE NAVIGATION CORRIGÉE === #}
                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_SERVER') %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_reservation_index') }}">Gestion Réservations</a>
                                </li>
                            {% else %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_reservation_index') }}">Mes Réservations</a>
                                </li>
                            {% endif %}
                            {# ========================================================= #}

                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_logout') }}">Déconnexion</a>
                            </li>

                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_register') }}">S'inscrire</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container mt-4">
            {% block body %}{% endblock %}
        </div>

        {# JavaScript ضروري للـ Responsive #}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>