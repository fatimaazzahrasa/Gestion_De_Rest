{% extends 'base.html.twig' %}
{% block title %}Liste des Réservations{% endblock %}
{% block body %}
    <h1>Liste des Réservations du Jour</h1>
    <table class="table">
        <thead>
            <tr>
                <th>Client</th>
                <th>Date</th>
                <th>Personnes</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            {% for reservation in reservations %}
                <tr>
                    <td>{{ reservation.customer.email }}</td>
                    <td>{{ reservation.reservationDate|date('d/m/Y H:i') }}</td>
                    <td>{{ reservation.nbrPersonne }}</td>
                    <td>{{ reservation.status }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
