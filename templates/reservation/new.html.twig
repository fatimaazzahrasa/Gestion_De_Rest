{# templates/reservation/new.html.twig #}

{# On hérite du modèle de base pour avoir le design et la barre de navigation #}
{% extends 'base.html.twig' %}

{% block title %}Faire une réservation{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1>Faire une nouvelle réservation</h1>

            {{ form_start(reservationForm) }}
                
                {# On utilise form_row pour afficher le label + le champ + les erreurs #}
                {{ form_row(reservationForm.reservation_date) }}
                {{ form_row(reservationForm.nbr_personne) }}

                <button type="submit" class="btn btn-primary mt-3">Réserver ma table</button>
                
            {{ form_end(reservationForm) }}
        </div>
    </div>
{% endblock %}
