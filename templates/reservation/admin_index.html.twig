{# templates/reservation/admin_index.html.twig #}

{% extends 'base.html.twig' %}
{% block title %}Gestion des Réservations{% endblock %}
{% block body %}
    <h1>Gestion de TOUTES les Réservations</h1>

    <a href="{{ path('app_reservation_new') }}" class="btn btn-primary mb-3">Ajouter une réservation</a>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Client</th>
                <th>Date</th>
                <th>Personnes</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for reservation in reservations %}
                <tr>
                    <td>{{ reservation.customer.email }}</td>
                    <td>{{ reservation.reservationDate|date('Y-m-d H:i') }}</td>
                    <td>{{ reservation.nbrPersonne }}</td>
                    <td>{{ reservation.status }}</td>
                    <td>
                        <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                        {# On n'inclut pas le formulaire de suppression pour l'instant #}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Aucune réservation trouvée.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
