{% extends 'base.html.twig' %}

{% block title %}Mes Réservations{% endblock %}

{% block body %}
    <h1>Mes Réservations</h1>

    <a href="{{ path('app_reservation_new') }}" class="btn btn-primary mb-3">Faire une nouvelle réservation</a>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Date</th>
                <th>Personnes</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for reservation in reservations %}
                <tr>
                    
                    <td>{{ reservation.getReservationDate() ? reservation.getReservationDate()|date('d/m/Y H:i') : '' }}</td>
                    
                    
                    <td>{{ reservation.getNbrPersonne() }}</td>
                    
                   
                    <td>{{ reservation.getStatus() }}</td>

                    
                    <td>
                        <div class="d-flex align-items-center">
                            <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}" class="btn btn-warning btn-sm me-2">Modifier</a>
                            {{ include('reservation/delete_form.html.twig') }}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center">Vous n'avez aucune réservation pour le moment.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
