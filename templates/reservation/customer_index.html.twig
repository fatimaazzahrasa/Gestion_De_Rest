{% extends 'base.html.twig' %}
{% block title %}Mes Réservations{% endblock %}
{% block body %}
    <h1>Mes Réservations</h1>
    <a href="{{ path('app_reservation_new') }}" class="btn btn-primary mb-3">Faire une nouvelle réservation</a>
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Personnes</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for reservation in reservations %}
                <tr>
                    <td>{{ reservation.reservationDate|date('d/m/Y H:i') }}</td>
                    <td>{{ reservation.nbrPersonne }}</td>
                    <td>{{ reservation.status }}</td>
                    <td>
                        <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">Modifier</a>
                        <a href="#">Annuler</a>  {# Le lien de suppression viendra plus tard #}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">Vous n'avez aucune réservation.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
